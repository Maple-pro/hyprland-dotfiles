# -----------------------------------------------------------------------------
# monique runtime state
#
# These files are rewritten by monique on every Apply and every profile switch,
# so tracking them would dirty the working tree constantly:
#
#   monitors.lua  the generated monitor rules that hyprland.lua loads; monique
#                 writes it when it applies a profile
#   settings.json the pinned profile, the active profile and the fingerprint of
#                 the monitors that were connected
#
# The real configuration — the four profile definitions in
# huawei/.config/monique/profiles/ — IS tracked.
#
# hyprland.lua reads monitors.lua when it exists and falls back to
# hypr/scripts/project-mode.lua when it does not, so a clone with neither file
# still starts correctly.
# -----------------------------------------------------------------------------
/huawei/.config/hypr/monitors.lua
/huawei/.config/monique/settings.json

# Legion Monique generated state (authored profile definitions stay tracked).
/legion/.config/hypr/monitors.lua
/legion/.config/monique/settings.json

# Compiled build artifact — the source (drm-free.c) next to it IS tracked.
# Rebuild with:
#   cc -O2 -o huawei/.config/hypr/scripts/drm-free \
#      huawei/.config/hypr/scripts/drm-free.c
/huawei/.config/hypr/scripts/drm-free

# Python caches generated by the repository-local Huawei regression tests.
/huawei/**/__pycache__/
/huawei/**/*.pyc
