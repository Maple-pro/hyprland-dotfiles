[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 190)
    origin = top-right
    offset = (14, 14)
    scale = 0
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Light, breeze, hicolor

    font = Hack Nerd Font 12
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    sticky_history = yes

    frame_width = 2
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    corner_radius = 12

    idle_threshold = 120
    transparency = 0

[urgency_low]
    background = "#e6e9ef"
    foreground = "#4c4f69"
    frame_color = "#1e66f5"
    timeout = 4

[urgency_normal]
    background = "#eff1f5"
    foreground = "#4c4f69"
    frame_color = "#8839ef"
    timeout = 6

[urgency_critical]
    background = "#d20f39"
    foreground = "#eff1f5"
    frame_color = "#d20f39"
    timeout = 0

