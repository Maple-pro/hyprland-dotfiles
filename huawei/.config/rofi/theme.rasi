/* Catppuccin Latte */

* {
    background-color: rgba(239, 241, 245, 0.96);
    foreground-color: #4c4f69;
    border-color: #ccd0da;
    selected-normal-background: rgba(30, 102, 245, 0.18);
    selected-normal-foreground: #4c4f69;
    selected-urgent-background: rgba(210, 15, 57, 0.22);
    selected-active-background: rgba(30, 102, 245, 0.22);
    text-color: #4c4f69;
    highlight: #1e66f5;
    urgent: #d20f39;
    active: #8839ef;
}

window {
    fullscreen: false;
    width: 36%;
    x-offset: 0;
    y-offset: 0;
    location: center;
    anchor: center;
    border: 2px;
    border-color: #ccd0da;
    border-radius: 14px;
    padding: 8px;
    transparency: "real";
}

inputbar {
    background-color: rgba(204, 208, 218, 0.80);
    border-radius: 8px;
    padding: 8px;
    children: [ prompt, entry ];
}

prompt {
    padding: 2px 8px 2px 4px;
    text-color: #8839ef;
    font: "Hack Nerd Font 13";
}

entry {
    padding: 2px;
    text-color: #4c4f69;
    caret-color: #1e66f5;
    font: "Hack Nerd Font 13";
}

listview {
    padding: 6px 0;
    border-radius: 8px;
    lines: 10;
    columns: 1;
    fixed-height: false;
    dynamic: true;
}

element {
    padding: 8px 10px;
    border-radius: 8px;
    text-color: #4c4f69;
    cursor: pointer;
}

element selected {
    background-color: rgba(30, 102, 245, 0.18);
    text-color: #4c4f69;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 1.2em;
    margin: 0 8px 0 0;
}
