{
    "layer": "top",
    "position": "top",
    // "height": 34,
    "height": 30,
    "spacing": 4,
// "margin-top": 8,
// "margin-left": 8,
// "margin-right": 8,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["pulseaudio", "custom/mic", "keyboard-state", "backlight", "battery", "memory", "cpu", "tray", "clock"],

    "hyprland/workspaces": {
        "format": "{name} <span size='small' alpha='62%'>{windows}</span>",
        "format-window-separator": " ",
        "window-rewrite-default": "{class}",
        "window-rewrite": {
            "class<([Ff]citx.*|org[.]fcitx[.].*)>": "",
            "class<(Chatgpt|chatgpt)>": "chatgpt",
            "class<(google-chrome|Google-chrome)>": "chrome",
            "class<(foot|footclient)>": "foot",
            "class<(konsole|org[.]kde[.]konsole)>": "konsole",
            "class<(yakuake|org[.]kde[.]yakuake)>": "yakuake",
            "class<(kate|org[.]kde[.]kate)>": "kate",
            "class<(kwrite|org[.]kde[.]kwrite)>": "kwrite",
            "class<(code|com.microsoft.VSCode)>": "vscode",
            "class<nvim>": "nvim",
            "class<vim>": "vim",
            "class<(dolphin|org[.]kde[.]dolphin)>": "dolphin",
            "class<(krusader|org[.]kde[.]krusader)>": "krusader",
            "class<(fsearch|io.github.cboxdoerfer.FSearch)>": "fsearch",
            "class<(ark|org[.]kde[.]ark)>": "ark",
            "class<wps>": "writer",
            "class<et>": "spreadsheet",
            "class<wpp>": "presentation",
            "class<(pdf|wpspdf)>": "pdf",
            "class<(okular|org[.]kde[.]okular)>": "okular",
            "class<typora>": "typora",
            "class<(calibre|ebook-edit|ebook-viewer)>": "calibre",
            "class<pdfarranger>": "pdfarranger",
            "class<docfetcher>": "docfetcher",
            "class<md.obsidian.Obsidian>": "obsidian",
            "class<gimp>": "gimp",
            "class<(gwenview|org[.]kde[.]gwenview)>": "gwenview",
            "class<flameshot>": "flameshot",
            "class<vlc>": "vlc",
            "class<baidunetdisk>": "baidu",
            "class<nm-connection-editor>": "network",
            "class<(blueman-manager|blueman-adapters)>": "bluetooth",
            "class<pavucontrol>": "volume",
            "class<(wechat|WeChat)>": "wechat",
            "class<(QQ|linuxqq)>": "qq",
            "class<cc-switch>": "ccswitch",
            "class<designer6>": "designer",
            "class<cmake-gui>": "cmake",
            "class<(kdiff3|org[.]kde[.]kdiff3)>": "kdiff3",
            "class<(krename|org[.]kde[.]krename)>": "krename",
            "class<(systemsettings|kcmshell6)>": "settings",
            "class<(plasma-systemmonitor|org[.]kde[.]plasma-systemmonitor)>": "sysmon",
            "class<(kinfocenter|org[.]kde[.]kinfocenter)>": "sysinfo",
            "class<(kfontview|org[.]kde[.]kfontview)>": "fontview",
            "class<pinentry-qt>": "pinentry",
            "class<system-config-printer>": "printer",
            "class<rofi>": "rofi",
            "class<mihomo-party>": "clash"
        },
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace m-1",
        "on-scroll-down": "hyprctl dispatch workspace m+1"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right"
        },
        "on-click-right": "mode",
        "interval": 10
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} 󰂰 {volume}%",
        "format-muted": "󰝟 MUTED",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc}\n{volume}%",
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer -ui 5",
        "on-scroll-down": "pamixer -d 5"
    },

    "custom/mic": {
        "exec": "/home/yangfeng/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 5,
        "tooltip": true,
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },

    "keyboard-state": {
        "capslock": true,
        "numlock": false,
        "format": "{icon}",
        "format-icons": {
            "locked": "󰪛",
            "unlocked": "󰪟"
        }
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-discharging": "{icon} {capacity}%",
        "format-not-charging": "󰂄 {capacity}%",
        "format-full": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}%",
        "tooltip-format-charging": "正在充电 {capacity}%",
        "tooltip-format-discharging": "使用电池 {capacity}%",
        "tooltip-format-not-charging": "已连接电源 {capacity}%",
        "tooltip-format-full": "已充满 {capacity}%"
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 5
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5
    },

    "custom/clash-party": {
        "exec": "/home/yangfeng/.config/waybar/scripts/clash-party.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 10,
        "on-click": "mihomo-party",
        "on-click-right": "pkill -f '/opt/clash-party/mihomo-party'"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
